        "from collections import deque\n",
        "\n",
        "def solve():\n",
        "    start = (3, 3, 1)\n",
        "    goal = (0, 0, 0)\n",
        "\n",
        "    queue = deque([(start, [])])\n",
        "    visited = set()\n",
        "\n",
        "    while queue:\n",
        "        state, path = queue.popleft()\n",
        "        m, c, boat = state\n",
        "\n",
        "        if state == goal:\n",
        "            for step in path + [state]:\n",
        "                print(step)\n",
        "            print(\"Solution found!\")\n",
        "            return\n",
        "\n",
        "        if state in visited:\n",
        "            continue\n",
        "        visited.add(state)\n",
        "\n",
        "        for x in range(3):\n",
        "            for y in range(3):\n",
        "                if 1 <= x + y <= 2:\n",
        "                    if boat == 1:\n",
        "                        new_state = (m - x, c - y, 0)\n",
        "                    else:\n",
        "                        new_state = (m + x, c + y, 1)\n",
        "\n",
        "                    nm, nc, _ = new_state\n",
        "\n",
        "                    if not (0 <= nm <= 3 and 0 <= nc <= 3):\n",
        "                        continue\n",
        "\n",
        "                    if ((nm == 0 or nm >= nc) and\n",
        "                        (3 - nm == 0 or 3 - nm >= 3 - nc)):\n",
        "                        queue.append((new_state, path + [state]))\n",
        "\n",
        "    print(\"No solution exists\")\n",
        "\n",
        "solve()"
      ]
