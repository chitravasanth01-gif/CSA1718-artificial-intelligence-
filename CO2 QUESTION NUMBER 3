      "source": [
        "# Minimax Algorithm using Tic-Tac-Toe\n",
        "\n",
        "def minimax(depth, is_max):\n",
        "    if depth == 3:\n",
        "        return 0\n",
        "\n",
        "    if is_max:\n",
        "        best = -1000\n",
        "        for score in [3, 5, 2]:\n",
        "            best = max(best, minimax(depth + 1, False) + score)\n",
        "        return best\n",
        "    else:\n",
        "        best = 1000\n",
        "        for score in [3, 5, 2]:\n",
        "            best = min(best, minimax(depth + 1, True) - score)\n",
        "        return best\n",
        "\n",
        "result = minimax(0, True)\n",
        "print(\"Best score:\", result)"
      ]
