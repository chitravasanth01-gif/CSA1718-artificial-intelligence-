        "def vacuum_cleaner():\n",
        "    room = {'A': 1, 'B': 1}\n",
        "    position = 'A'\n",
        "\n",
        "    print(\"Initial Room Status:\", room)\n",
        "\n",
        "    while 1 in room.values():\n",
        "        if room[position] == 1:\n",
        "            print(\"Room\", position, \"is Dirty. Cleaning...\")\n",
        "            room[position] = 0\n",
        "            print(\"Room\", position, \"is now Clean.\")\n",
        "        else:\n",
        "            print(\"Room\", position, \"is already Clean.\")\n",
        "\n",
        "        if position == 'A':\n",
        "            position = 'B'\n",
        "        else:\n",
        "            position = 'A'\n",
        "\n",
        "    print(\"All rooms are clean!\")\n",
        "    print(\"Final Room Status:\", room)\n",
        "\n",
        "vacuum_cleaner()"
      ]
