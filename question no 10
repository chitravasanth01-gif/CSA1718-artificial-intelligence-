      "source": [
        "def astar(graph, h, start, goal):\n",
        "    open_list = [(h[start], 0, start, [start])]\n",
        "    visited = set()\n",
        "\n",
        "    while open_list:\n",
        "        open_list.sort()\n",
        "        f, g, node, path = open_list.pop(0)\n",
        "\n",
        "        if node == goal:\n",
        "            print(\"Path:\", path)\n",
        "            print(\"Cost:\", g)\n",
        "            return\n",
        "\n",
        "        if node in visited:\n",
        "            continue\n",
        "        visited.add(node)\n",
        "\n",
        "        for neighbor, cost in graph[node].items():\n",
        "            if neighbor not in visited:\n",
        "                new_g = g + cost\n",
        "                new_f = new_g + h[neighbor]\n",
        "                open_list.append(\n",
        "                    (new_f, new_g, neighbor, path + [neighbor])\n",
        "                )\n",
        "\n",
        "    print(\"No path found\")\n",
        "\n",
        "graph = {\n",
        "    'A': {'B': 1, 'C': 4},\n",
        "    'B': {'D': 2, 'E': 5},\n",
        "    'C': {'E': 1},\n",
        "    'D': {'G': 5},\n",
        "    'E': {'G': 3},\n",
        "    'G': {}\n",
        "}\n",
        "\n",
        "h = {'A': 7, 'B': 6, 'C': 4, 'D': 4, 'E': 2, 'G': 0}\n",
        "\n",
        "astar(graph, h, 'A', 'G')"
      ]
    }
