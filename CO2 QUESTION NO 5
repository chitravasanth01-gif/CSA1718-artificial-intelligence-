        "# Decision Tree using Python\n",
        "\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "# Training data\n",
        "X = [[1], [2], [3], [4], [5], [6]]\n",
        "y = [0, 0, 0, 1, 1, 1]\n",
        "\n",
        "# Create Decision Tree model\n",
        "model = DecisionTreeClassifier()\n",
        "\n",
        "# Train the model\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict output\n",
        "prediction = model.predict([[4]])\n",
        "\n",
        "print(\"Predicted class:\", prediction[0])"
      ]
