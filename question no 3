        "from collections import deque\n",
        "\n",
        "def water_jug(cap1, cap2, target):\n",
        "    queue = deque([(0, 0)])\n",
        "    visited = set()\n",
        "\n",
        "    while queue:\n",
        "        x, y = queue.popleft()\n",
        "\n",
        "        if (x, y) in visited:\n",
        "            continue\n",
        "        visited.add((x, y))\n",
        "\n",
        "        print(x, y)\n",
        "\n",
        "        if x == target or y == target:\n",
        "            print(\"Target achieved!\")\n",
        "            return\n",
        "\n",
        "        states = [\n",
        "            (cap1, y),                    # Fill jug 1\n",
        "            (x, cap2),                    # Fill jug 2\n",
        "            (0, y),                       # Empty jug 1\n",
        "            (x, 0),                       # Empty jug 2\n",
        "            (x - min(x, cap2 - y),        # Pour jug 1 into jug 2\n",
        "             y + min(x, cap2 - y)),\n",
        "            (x + min(y, cap1 - x),        # Pour jug 2 into jug 1\n",
        "             y - min(y, cap1 - x))\n",
        "        ]\n",
        "\n",
        "        for state in states:\n",
        "            if state not in visited:\n",
        "                queue.append(state)\n",
        "\n",
        "    print(\"Solution not possible\")\n",
        "\n",
        "water_jug(4, 3, 2)"
      ]
