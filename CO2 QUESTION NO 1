      "source": [
        "# Map Coloring using Constraint Satisfaction Problem (CSP)\n",
        "\n",
        "colors = ['Red', 'Green', 'Blue']\n",
        "\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['A', 'C', 'D'],\n",
        "    'C': ['A', 'B', 'D'],\n",
        "    'D': ['B', 'C']\n",
        "}\n",
        "\n",
        "coloring = {}\n",
        "\n",
        "def is_valid(region, color):\n",
        "    for neighbor in graph[region]:\n",
        "        if neighbor in coloring and coloring[neighbor] == color:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def solve():\n",
        "    if len(coloring) == len(graph):\n",
        "        return True\n",
        "\n",
        "    region = next(r for r in graph if r not in coloring)\n",
        "\n",
        "    for color in colors:\n",
        "        if is_valid(region, color):\n",
        "            coloring[region] = color\n",
        "\n",
        "            if solve():\n",
        "                return True\n",
        "\n",
        "            del coloring[region]\n",
        "\n",
        "    return False\n",
        "\n",
        "if solve():\n",
        "    print(\"Map Coloring Solution:\")\n",
        "    for region, color in coloring.items():\n",
        "        print(region, \":\", color)\n",
        "else:\n",
        "    print(\"No solution exists\")"
      ]
    }
